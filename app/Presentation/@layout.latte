<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Katalog knih</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-body-tertiary">
	<nav class="navbar bg-dark mb-4" data-bs-theme="dark">
		<div class="container">
			<a class="navbar-brand" n:href="Book:default">Katalog knih</a>

			<div n:if="$user->isLoggedIn()" class="d-flex align-items-center gap-3">
				<span class="navbar-text">{$user->getIdentity()->email}</span>
				<a n:href="logout!" class="btn btn-outline-light btn-sm">Odhlásit se</a>
			</div>
		</div>
	</nav>

	<main class="container pb-5">
		<div n:foreach="$flashes as $flash" class="alert alert-{$flash->type}">{$flash->message}</div>

		{include content}
	</main>
</body>
</html>